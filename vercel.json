{
  "framework": null,
  "buildCommand": "pnpm build && node scripts/bundle-api.mjs",
  "outputDirectory": "build/client",
  "rewrites": [
    {
      "source": "/extended/:path*",
      "destination": "https://api.starknet.extended.exchange/:path*"
    },
    {
      "source": "/rh-mainnet",
      "destination": "https://rpc.mainnet.chain.robinhood.com"
    },
    {
      "source": "/rh-mainnet/:path*",
      "destination": "https://rpc.mainnet.chain.robinhood.com/:path*"
    },
    {
      "source": "/cmc/:path*",
      "destination": "https://api.coinmarketcap.com/:path*"
    },
    {
      "source": "/rhj/:path*",
      "destination": "https://api.robinhood.com/rhj/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
